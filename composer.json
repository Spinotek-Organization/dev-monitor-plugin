{
    "name": "spinotek/dev-monitor-plugin",
    "description": "Standalone Dev Monitoring, Task Manager & Version Log Plugin for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Spinotek",
            "email": "dev@spinotek.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Spinotek\\TaskMonitoring\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spinotek\\TaskMonitoring\\MonitoringServiceProvider"
            ]
        }
    }
}
